{
  "version": 1,
  "name": "Agentic_Framework",
  "comment": "Metadata for bundled roles and skills. Core files are tool-agnostic; deploy/ is generated from them for each target. Roles marked external already exist globally for both tools and are only referenced.",
  "targets": {
    "claude": {
      "agent_ext": "md",
      "model": "sonnet",
      "effort": "medium",
      "dest_agents": "agents",
      "dest_skills": "skills"
    },
    "codex": {
      "agent_ext": "toml",
      "model": "gpt-6-luna",
      "effort": "medium",
      "dest_agents": "agents",
      "dest_skills": "skills"
    }
  },
  "bundled_agents": [
    "a11y-architect",
    "architect",
    "build-error-resolver",
